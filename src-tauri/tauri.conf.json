{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RalphX",
  "version": "0.95.0",
  "identifier": "com.ralphx.app",
  "build": {
    "beforeDevCommand": "../src-tauri/scripts/build-workflow-runner.sh dev && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "../src-tauri/scripts/build-workflow-runner.sh release && npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/ralphx-workflow-runner"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../plugins/app": "plugins/app",
      "../agents": "agents",
      "../config": "config",
      "../release-notes": "release-notes"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQjZBMDE2QjU1ODdDNTIKUldSU2ZGaTFGcUMyZkJJSUNTSDRIN3BaSXJ4T0RaUUhwR3hzVXpiUUl5MUVEamtndWpFeEdCODgK",
      "endpoints": [
        "https://github.com/aigentive/ralphx.app/releases/download/updater-{{target}}/latest-{{arch}}.json"
      ]
    }
  }
}
