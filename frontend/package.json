  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc && vite build",
    "build:web": "vite build --mode web --outDir dist-web",
    "preview": "vite preview",
    "tauri": "cd .. && ./frontend/node_modules/.bin/tauri",
    "test": "vitest",
    "test:run": "vitest run",
    "test:check-warnings": "./scripts/check-vitest-warnings.sh",
    "test:visual": "playwright test tests/visual --workers=1",
    "test:coverage": "vitest run --coverage --testTimeout=15000 --retry=1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:tokens": "./scripts/check-design-tokens.sh",
    "hooks:install": "git -C .. config core.hooksPath .githooks"
  },
